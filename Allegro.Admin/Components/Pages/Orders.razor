@page "/orders"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@inject ToastService toastService
@inject AllegroPublishService allegro
@inject IJSRuntime js
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Orders & purchases · Allegro parser</PageTitle>

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 no-print">
    <h1 class="mb-0">Orders & purchases</h1>
    <div class="d-flex align-items-center flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="/">← Back to dashboard</a>
        <a class="btn btn-outline-secondary" href="/stock">My stock</a>
        <form action="/auth/logout" method="post" class="m-0">
            <button class="btn btn-outline-danger" type="submit">Logout</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4 no-print">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center">
        <button class="btn btn-outline-primary" disabled="@(!allegro.Settings.IsConnected || allegro.IsSyncingOrders)" @onclick="SyncNow">
            @(allegro.IsSyncingOrders ? "Syncing..." : "Sync orders now")
        </button>
        <div class="small text-muted">
            @if (_state.LastSyncAt == DateTime.MinValue)
            {
                <span>Orders have not been read yet. The panel checks Allegro every 5 minutes while the account is connected.</span>
            }
            else
            {
                <span>Last check @_state.LastSyncAt.ToString("yyyy-MM-dd HH:mm").</span>
            }
            @if (_state.LastError.Length > 0)
            {
                <span class="text-danger"> Last error: @_state.LastError</span>
                @if (_state.LastError.Contains("403") || _state.LastError.Contains("401"))
                {
                    <span class="text-danger"> The Allegro app needs the <code>allegro:api:orders:read</code> scope; after enabling it, reconnect the account on the dashboard.</span>
                }
            }
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">Purchase list · next trip @NextTrip.ToString("dddd, d MMMM", CultureInfo.InvariantCulture)</span>
        <div class="d-flex gap-2 no-print">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(_purchase.Count == 0)" @onclick="Print">Print / PDF</button>
            <button class="btn btn-sm btn-success" disabled="@(_purchase.Count == 0 || _isConfirming)" @onclick="ConfirmPurchase">
                @(_isConfirming ? "Saving..." : "Bought - put leftovers on my stock")
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (_purchase.Count == 0)
        {
            <div class="p-4 text-center text-muted">Nothing to buy: every open order is covered by own stock.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Needed</th>
                            <th class="text-end">Min order</th>
                            <th class="text-end">Buy</th>
                            <th class="text-end">Left over</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Orders</th>
                            <th class="no-print" style="width: 110px">Bought</th>
                            <th class="no-print" style="width: 120px">Paid / piece</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _purchase)
                        {
                            var bought = _bought[row.Ean];
                            <tr>
                                <td>
                                    @if (row.Product is not null)
                                    {
                                        <a href="@row.Product.Url" target="_blank" rel="noreferrer" class="fw-semibold text-decoration-none">@row.Name</a>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@row.Name</span>
                                    }
                                    <div class="small"><code>@row.Ean</code>
                                        @if (!row.SupplierHas)
                                        {
                                            <span class="badge bg-danger ms-1">supplier: brak</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end">@row.Need</td>
                                <td class="text-end">@row.Moq</td>
                                <td class="text-end fw-bold">@row.Buy</td>
                                <td class="text-end">@(row.Leftover > 0 ? row.Leftover.ToString() : "—")</td>
                                <td class="text-end">@row.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td class="text-end">@row.Total.ToString("0.00", CultureInfo.InvariantCulture)</td>
                                <td class="text-end">@row.OrderIds.Count</td>
                                <td class="no-print"><input class="form-control form-control-sm" type="number" min="0" @bind="bought.Quantity" /></td>
                                <td class="no-print"><input class="form-control form-control-sm" type="number" min="0" step="0.01" @bind="bought.UnitCost" /></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th>@_purchase.Count products</th>
                            <th class="text-end">@_purchase.Sum(r => r.Need)</th>
                            <th></th>
                            <th class="text-end">@_purchase.Sum(r => r.Buy)</th>
                            <th class="text-end">@_purchase.Sum(r => r.Leftover)</th>
                            <th></th>
                            <th class="text-end">@_purchase.Sum(r => r.Total).ToString("0.00", CultureInfo.InvariantCulture)</th>
                            <th></th>
                            <th class="no-print" colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="p-3 small text-muted no-print">
                Quantities are pieces, rounded up to the supplier's minimum order across all open orders together.
                After the trip, correct <em>Bought</em> where you bought more, less or nothing (0 keeps those orders
                waiting for the next trip), then press <em>Bought</em>: what the orders need is set aside, the rest
                goes to own stock at the paid price.
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-4 no-print">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">Orders</span>
        <span class="small text-muted">@_orders.Count(o => o.Status == OrderStatus.Open) open · @_orders.Count(o => o.Status == OrderStatus.Purchased) bought · @_orders.Count(o => o.Status == OrderStatus.Cancelled) cancelled</span>
    </div>
    <div class="card-body p-0">
        @if (_orders.Count == 0)
        {
            <div class="p-4 text-center text-muted">No orders tracked yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>When</th>
                            <th>Order</th>
                            <th>Buyer</th>
                            <th>Lines</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _orders.Take(100))
                        {
                            <tr>
                                <td class="text-nowrap small">@order.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><a href="https://salescenter.allegro.com/orders/@order.Id" target="_blank" rel="noreferrer" class="small text-decoration-none"><code>@order.Id[..8]…</code></a></td>
                                <td class="small">@order.Buyer</td>
                                <td class="small">
                                    @if (order.Lines.Count == 0)
                                    {
                                        <span class="text-muted">@order.Note</span>
                                    }
                                    @foreach (var line in order.Lines)
                                    {
                                        <div>
                                            @line.Name <code>@line.Ean</code> × @line.Packs@(line.Pack > 1 ? $" packs of {line.Pack}" : "")
                                            <span class="text-muted">= @line.Need pcs:</span>
                                            @if (line.FromOwn > 0)
                                            {
                                                <span class="badge bg-primary">@line.FromOwn from stock</span>
                                            }
                                            @if (line.ToBuy > 0)
                                            {
                                                <span class="badge @(line.PurchasedAt is null ? "bg-warning text-dark" : "bg-success")">@line.ToBuy @(line.PurchasedAt is null ? "to buy" : "bought")</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge @StatusCss(order.Status)">@order.Status</span>
                                    @if (order.Status == OrderStatus.Cancelled && order.Note.Length > 0)
                                    {
                                        <div class="small text-muted">@order.Note</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private OrderSyncState _state = new();
    private List<TrackedOrder> _orders = new();
    private List<PurchaseRow> _purchase = new();
    private Dictionary<string, BoughtVm> _bought = new(StringComparer.OrdinalIgnoreCase);
    private bool _isConfirming;

    private sealed class BoughtVm
    {
        public int Quantity { get; set; }
        public decimal? UnitCost { get; set; }
    }

    private static DateTime NextTrip => OrderSync.NextTrip(DateTime.Now);

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _state = OrderSync.State();
        _orders = OrderSync.Orders().Values.OrderByDescending(o => o.OccurredAt).ToList();
        _purchase = OrderSync.PurchaseList();
        _bought = _purchase.ToDictionary(r => r.Ean, r => new BoughtVm { Quantity = r.Buy, UnitCost = r.UnitPrice > 0 ? r.UnitPrice : null }, StringComparer.OrdinalIgnoreCase);
    }

    private static string StatusCss(string status) => status switch
    {
        OrderStatus.Open => "bg-warning text-dark",
        OrderStatus.Purchased => "bg-success",
        OrderStatus.Cancelled => "bg-secondary",
        _ => "bg-light text-dark",
    };

    private async Task SyncNow()
    {
        try
        {
            var handled = await allegro.SyncOrdersAsync();
            toastService.ShowSuccess($"Orders synced: {handled} new events handled.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        Load();
    }

    private void ConfirmPurchase()
    {
        _isConfirming = true;
        try
        {
            var done = allegro.ConfirmPurchase(_bought.Select(b => new OrderSync.Bought(b.Key, b.Value.Quantity, b.Value.UnitCost)));
            toastService.ShowSuccess($"{done} products marked as bought.");
            Load();
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isConfirming = false;
        }
    }

    private async Task Print()
    {
        try
        {
            await js.InvokeVoidAsync("window.print");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }
}
