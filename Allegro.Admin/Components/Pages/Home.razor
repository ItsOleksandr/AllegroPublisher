@page "/"
@using System.Collections.Concurrent
@using System.Diagnostics
@using Allegro.Admin.Models
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@inject ToastService toastService
@inject Saver<SaveData> saveData
@inject AllegroPublishService allegro
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Allegro parser</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0">Allegro parser</h1>
    <div class="d-flex align-items-center flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="/products">Products</a>
        <a href="https://salescenter.allegro.com/import-and-list" class="btn btn-outline-secondary" target="_blank">sales center allegro</a>
        <button class="btn btn-success" @onclick="SaveAllOptions">Save all options</button>
        <form action="/auth/logout" method="post" class="m-0">
            <button class="btn btn-outline-danger" type="submit">Logout</button>
        </form>
    </div>
</div>

<div class="row g-3">

    <div class="col-12 col-xl-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Last parsing</div>
            <div class="card-body">
                <div class="row text-center mb-3">
                    <div class="col">
                        <div class="fs-4 fw-bold">@_lastParsing.AllUrls.Count</div>
                        <div class="text-muted small">All urls</div>
                    </div>
                    <div class="col">
                        <div class="fs-4 fw-bold text-success">@_lastParsing.Products.Count</div>
                        <div class="text-muted small">Success</div>
                    </div>
                    <div class="col">
                        <div class="fs-4 fw-bold text-danger">@(_lastParsing.AllUrls.Count - _lastParsing.Products.Count)</div>
                        <div class="text-muted small">Failed / black list</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small text-muted">Progress</span>
                    <span class="small text-muted">@_progressPercent%</span>
                </div>
                <div class="progress mb-3" role="progressbar" aria-valuenow="@_progressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(_progressPercent)%"></div>
                </div>

                <span class="badge @(_isLastParseSuccess ? "bg-success" : "bg-warning text-dark")">
                    @(_isLastParseSuccess ? "Success" : $"Failure on {_lastParsing.CurrentIndexUrl}")
                </span>

                @if (_lastParsing.BlackListUrls.Count > 0)
                {
                    <details class="mt-3">
                        <summary class="small text-muted">Show failed / invalid urls (@_lastParsing.BlackListUrls.Count)</summary>
                        <ul class="small mt-2">
                            @foreach (var url in _lastParsing.BlackListUrls)
                            {
                                <li>@url</li>
                            }
                        </ul>
                    </details>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header fw-semibold">Listing rules</div>
            <div class="card-body">
                <div class="row g-3 mb-2">
                    <div class="col-6">
                        <label class="form-label" for="minProductCountInput">Minimal product count</label>
                        <input id="minProductCountInput" class="form-control" type="number" min="0" @bind="_listingOptions.MinimalProductCount" />
                        <div class="form-text">Categories with fewer parsed products than this are not put on sale.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="minPriceInput">Minimal price</label>
                        <input id="minPriceInput" class="form-control" type="number" step="0.01" min="0" @bind="_listingOptions.MinimalPrice" />
                        <div class="form-text">Products priced below this value are not put on sale.</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="bundleFromInput">Sell as a pack above</label>
                        <input id="bundleFromInput" class="form-control" type="number" min="0" @bind="_listingOptions.BundleFromQuantity" />
                        <div class="form-text">
                            Products whose supplier minimum order is above this are listed as a single pack
                            of that size, priced and stocked per pack, instead of individually. 0 = off.
                        </div>
                    </div>
                    <div class="col-6">
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Price multipliers</label>
                    <div class="form-text mb-2">
                        The parsed price is multiplied by the first tier whose <strong>up-to price</strong> is ≥ the price
                        (lowest first). Prices above every tier use the <strong>default multiplier</strong>.
                    </div>
                    <table class="table table-sm align-middle mb-2" style="max-width: 520px;">
                        <thead class="table-light">
                            <tr>
                                <th>Price up to</th>
                                <th>× multiplier</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tier in _listingOptions.PriceMultipliers.OrderBy(t => t.MaxPrice).ToList())
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="tier.MaxPrice" /></td>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="tier.Multiplier" /></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _listingOptions.PriceMultipliers.Remove(tier)">✕</button>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted small align-middle">above → default</td>
                                <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="_listingOptions.DefaultMultiplier" /></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddPriceTier">Add tier</button>
                </div>

                <div class="mb-3">
                    <label class="form-label">Pack splitting</label>
                    <div class="form-text mb-2">
                        How much of the supplier's minimum order goes into one pack. The first row whose
                        <strong>minimum order up to</strong> is ≥ the product's minimum order wins; anything larger
                        uses the default. A minimum order that does not divide evenly by its divisor is listed
                        whole, so nothing is ever rounded away. Divisor <strong>1</strong> = do not split.
                    </div>
                    <table class="table table-sm align-middle mb-2" style="max-width: 520px;">
                        <thead class="table-light">
                            <tr>
                                <th>Minimum order up to</th>
                                <th>÷ divisor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tier in _listingOptions.PackDivisors.OrderBy(t => t.MaxMinOrder).ToList())
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" type="number" min="0" @bind="tier.MaxMinOrder" /></td>
                                    <td><input class="form-control form-control-sm" type="number" min="1" @bind="tier.Divisor" /></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _listingOptions.PackDivisors.Remove(tier)">✕</button>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted small align-middle">above → default</td>
                                <td><input class="form-control form-control-sm" type="number" min="1" @bind="_listingOptions.PackDefaultDivisor" /></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddPackTier">Add tier</button>
                </div>

                

                <div class="mb-3">
                    <label class="form-label">Pack multipliers</label>
                    <div class="form-text mb-2">
                        The same ladder, but for packs, and read against the <strong>cost of the whole pack</strong>
                        rather than of one item — so bulk can be marked up more gently. Packs never use the tiers
                        above. Leave the table empty to give every pack the default.
                    </div>
                    <table class="table table-sm align-middle mb-2" style="max-width: 520px;">
                        <thead class="table-light">
                            <tr>
                                <th>Pack cost up to</th>
                                <th>× multiplier</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tier in _listingOptions.BundlePriceMultipliers.OrderBy(t => t.MaxPrice).ToList())
                            {
                                <tr>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="tier.MaxPrice" /></td>
                                    <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="tier.Multiplier" /></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _listingOptions.BundlePriceMultipliers.Remove(tier)">✕</button>
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted small align-middle">above → default</td>
                                <td><input class="form-control form-control-sm" type="number" step="0.01" min="0" @bind="_listingOptions.BundleDefaultMultiplier" /></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-sm btn-outline-primary" @onclick="AddBundlePriceTier">Add tier</button>
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label">Category black list</label>
                        <TagListEditor Items="_listingOptions.CategoriesBlackList"
                                       Placeholder="e.g. Electronics"
                                       EmptyText="Empty — no category is excluded." />
                        <div class="form-text">A product is excluded when any of its category urls contains one of these.</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">EAN black list</label>
                        <TagListEditor Items="_listingOptions.EansBlackList"
                                       Placeholder="e.g. 5901234123457"
                                       EmptyText="Empty — no EAN is excluded." />
                        <div class="form-text">Products with these exact EANs are never put on sale.</div>
                    </div>
                </div>
                <div class="small text-muted mb-2">
                    Stored in <code>listing_options.txt</code>. They decide which parsed products are on sale, and at what
                    price — applied on every publish, straight from the parsed catalogue. Use
                    <strong>Save all options</strong> above to persist changes.
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Parser</span>
                <span class="badge @(isStartedConsole ? "bg-success" : "bg-secondary")">
                    @(isStartedConsole ? $"Running (PID {saveData.Value.StartedConsoleId})" : "Not running")
                </span>
            </div>
            <div class="card-body">
                <label class="form-label" for="pathDllInput">Path to console.dll</label>
                <input id="pathDllInput" class="form-control mb-1" type="text" @bind="@saveData.Value.PathDllConsole" placeholder="Path to console.dll" />
                <div class="form-text mb-3">Full path to the compiled <code>Allegro.Console.dll</code> file that will be launched by the buttons below.</div>

                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button class="btn btn-primary" disabled="@isStartedConsole" @onclick="()=>StartConsole(saveData.Value.PathDllConsole,_consoleBaseStartOptions.Args)">Start parsing</button>
                    <button class="btn btn-outline-primary" disabled="@isStartedConsole" @onclick="()=>StartConsole(saveData.Value.PathDllConsole,_consoleBrowserOnlyOptions.Args)">Only Browser</button>
                    @if (isStartedConsole)
                    {
                        <button class="btn btn-danger ms-auto" @onclick="StopConsole">Stop console</button>
                    }
                </div>
                <div class="form-text mb-3">
                    <strong>Start parsing</strong> runs a full parse over the saved url list. <strong>Only Browser</strong> just opens/configures the browser without parsing, useful for logging in manually first.
                </div>

                <hr />

                <h6 class="fw-semibold">Test single product</h6>
                <div class="input-group mb-1">
                    <input class="form-control" type="url" @bind="_consoleAdvancedOptions.TestUrl" placeholder="https://allenett.pl/produkt/..." />
                </div>
                <div class="form-text mb-3">
                    Parses just this one product and prints the result in <strong>Console output</strong> below.
                    Nothing is saved. Use it to check selectors after the site changes.
                </div>

                <hr />

                <h6 class="fw-semibold">Advanced options</h6>
                <div class="row g-3 align-items-end mb-2">
                    <div class="col-12 col-md-3">
                        <label class="form-label" for="startIndexInput">Start index</label>
                        <input id="startIndexInput" class="form-control" type="number" @bind="_consoleAdvancedOptions.StartIndex" placeholder="Start from index [0 .. length]" />
                        <div class="form-text">Skips ahead and resumes parsing from this position in the url list instead of starting at 0.</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-check">
                            <input id="load_last_session" class="form-check-input" type="checkbox" @bind="_consoleAdvancedOptions.LoadLastSession" />
                            <label class="form-check-label" for="load_last_session">Load last session</label>
                        </div>
                        <div class="form-text">Loads the last parse and continues it</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-check">
                            <input id="configureBrowserCheck" class="form-check-input" type="checkbox" @bind="_consoleAdvancedOptions.ConfigureBrowser" />
                            <label class="form-check-label" for="configureBrowserCheck">Only configure browser</label>
                        </div>
                        <div class="form-text">Opens the browser for setup (e.g. login) without running the parser.</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="form-check">
                            <input id="isUserStartCheck" class="form-check-input" type="checkbox" @bind="_consoleAdvancedOptions.IsVisible" />
                            <label class="form-check-label" for="isUserStartCheck">Is visible browser</label>
                        </div>
                        <div class="form-text">If you wanna see your browser actions</div>
                    </div>
                </div>
                <button class="btn btn-secondary" disabled="@isStartedConsole" @onclick="()=>StartConsole(saveData.Value.PathDllConsole,_consoleAdvancedOptions.Args)">Start advanced</button>
            </div>
        </div>
    </div>
    
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Console output</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLogs">Clear</button>
            </div>
            <div class="card-body">
                <pre class="bg-dark text-light p-3 rounded mb-2" style="max-height: 320px; overflow-y: auto; font-size: 0.8rem; white-space: pre-wrap;">@(_consoleLogs.IsEmpty ? "No output yet." : string.Join("\n", _consoleLogs))</pre>
                <div class="form-text">Live stdout/stderr from a console process started in this admin session. Output from processes started before the admin app last restarted isn't available.</div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Publish to Allegro</span>
                <span class="badge @(allegro.Settings.IsConnected ? "bg-success" : "bg-secondary")">
                    @(allegro.Settings.IsConnected ? "Connected" : "Not connected")
                </span>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="clientIdInput">Client ID</label>
                        <input id="clientIdInput" class="form-control" type="text" @bind="allegro.Settings.ClientId" />
                        <div class="form-text">Client ID of your app from <code>apps.developer.allegro.pl</code>.</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="clientSecretInput">Client Secret</label>
                        <input id="clientSecretInput" class="form-control" type="password" @bind="allegro.Settings.ClientSecret" />
                        <div class="form-text">Client Secret of the same app. Stored locally in <code>allegro_settings.txt</code>.</div>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label" for="currencyInput">Currency</label>
                        <input id="currencyInput" class="form-control" type="text" @bind="allegro.Settings.Currency" />
                        <div class="form-text">e.g. PLN.</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <button class="btn btn-outline-primary" @onclick="ConnectAllegro">@(allegro.Settings.IsConnected ? "Reconnect account" : "Connect account")</button>
                    <button class="btn btn-outline-primary" @onclick="RefreshTokenAllegro">Try refresh token</button>
                    <button class="btn btn-success" disabled="@(!allegro.Settings.IsConnected || allegro.IsPublishing)" @onclick="PublishToAllegro">
                        @(allegro.IsPublishing ? "Publishing..." : "Publish to Allegro")
                    </button>
                </div>

                @if (_deviceInfo is not null)
                {
                    <div class="alert alert-info py-2 mb-2">
                        Open <a href="@_deviceInfo.VerificationUri" target="_blank">@_deviceInfo.VerificationUri</a>
                        and confirm the code <strong>@_deviceInfo.UserCode</strong>. This panel updates to
                        <em>Connected</em> once you approve.
                    </div>
                }

                <div class="form-text mb-3">
                    Prices the parsed catalogue with the options above and updates <strong>price and stock</strong> on existing
                    offers. Offers are matched by their <strong>external ID = EAN</strong>. Products with no matching offer are skipped
                    (new offers are not created).
                </div>

                <hr />

                <h6 class="fw-semibold">Sell as packs</h6>
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <button class="btn btn-outline-secondary" disabled="@(!allegro.Settings.IsConnected || _isPlanningBundles)" @onclick="BuildBundlePlan">
                        @(_isPlanningBundles ? "Building..." : "Build pack plan")
                    </button>
                    @if (_bundlePlan is not null && _convertibleBundles > 0)
                    {
                        <button class="btn btn-primary" disabled="@_isConverting" @onclick="ConvertBundles">
                            @(_isConverting ? "Converting..." : $"Convert {_convertibleBundles} offer(s)")
                        </button>
                    }
                </div>
                <div class="form-text mb-2">
                    Products the supplier will not sell singly — minimum order above
                    <strong>@_listingOptions.BundleFromQuantity</strong> — are listed as one pack instead of one item.
                    Converting changes the offer <strong>in place</strong>: it keeps its id, history and search
                    position, and quantity, price, stock and title all move in one request, so a pack is never
                    briefly on sale at the price of a single unit. Raising the threshold later takes these offers
                    back to single units. Building the plan is read-only.
                </div>

                @if (_bundlePlan is not null)
                {
                    @if (_bundlePlan.Count == 0)
                    {
                        <div class="alert alert-success py-2">No product has a minimum order above the threshold.</div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2">
                            <strong>@_convertibleBundles</strong> offer(s) can be converted in place.
                            @foreach (var reason in _bundlePlan.Where(c => !c.CanConvert)
                                                              .GroupBy(c => c.Problem)
                                                              .OrderByDescending(g => g.Count()))
                            {
                                <div class="small">@reason.Count() — @reason.Key</div>
                            }
                        </div>
                        <div class="table-responsive mb-3" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>EAN</th><th class="text-end">Pack</th><th class="text-end">Stock</th>
                                        <th class="text-end">Price now</th><th class="text-end">As pack</th><th>New title</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var change in _bundlePlan.Where(c => c.CanConvert))
                                    {
                                        <tr>
                                            <td><code>@change.Ean</code></td>
                                            <td class="text-end">@change.PackSize</td>
                                            <td class="text-end">@change.NewStock</td>
                                            <td class="text-end text-muted">@change.OldOfferPrice.ToString("0.00")</td>
                                            <td class="text-end fw-semibold">@change.NewOfferPrice.ToString("0.00")</td>
                                            <td class="small">@change.NewName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                <hr />

                <h6 class="fw-semibold">Products with no offer</h6>
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span class="badge @(_unlistedNew > 0 ? "bg-warning text-dark" : "bg-secondary") fs-6">
                        @_unlistedNew new
                    </span>
                    <span class="text-muted small">@_unlistedTotal without an offer in total</span>
                    <button class="btn btn-outline-secondary" disabled="@(_unlistedNew == 0)" @onclick="MarkImported">
                        Mark as imported
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@(!allegro.Settings.IsConnected || _isScanningUnlisted)" @onclick="ScanUnlisted">
                        @(_isScanningUnlisted ? "Scanning..." : "Scan unlisted products")
                    </button>
                </div>
                <div class="form-text mb-2">
                    Publishing only ever updates offers that already exist, so a product the supplier added after
                    the storefront was built stays invisible however often the job runs. The counter is filled in by
                    the last publish and costs nothing to read — press <strong>Mark as imported</strong> once you have
                    listed them, and it counts only what appears after that. <strong>Scan unlisted products</strong>
                    asks Allegro for the state right now and also looks up a catalogue card for each one.
                </div>

                @if (_unlisted is not null)
                {
                    <div class="alert alert-info py-2">
                        <strong>@_unlisted.Count(c => c.CanCreate)</strong> product(s) have a catalogue card and could be listed.
                        @if (_unlisted.Any(c => !c.CanCreate))
                        {
                            <span>@_unlisted.Count(c => !c.CanCreate) could not be resolved.</span>
                        }
                    </div>
                }

                <hr />

                <h6 class="fw-semibold">Offers that should no longer be on sale</h6>
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <button class="btn btn-outline-secondary" disabled="@(!allegro.Settings.IsConnected || _isScanning)" @onclick="ScanOrphanOffers">
                        @(_isScanning ? "Scanning..." : "Scan active offers")
                    </button>
                    @if (_orphanOffers is { Count: > 0 })
                    {
                        <button class="btn btn-danger" disabled="@_isEndingOrphans" @onclick="EndOrphanOffers">
                            @(_isEndingOrphans ? "Ending..." : $"End all {_orphanOffers.Count}")
                        </button>
                    }
                </div>
                <div class="form-text mb-2">
                    Finds <strong>active</strong> offers listed by this app (they carry an <strong>external ID</strong>)
                    whose product is in the parsed catalogue but <strong>no longer passes the listing options above</strong> —
                    a blacklisted category, a blacklisted EAN, stock below the minimum, and so on. Offers listed
                    <strong>manually or by another tool</strong>, and products the parser has never seen, are never
                    reported or touched. Scanning is read-only; nothing changes until you press End.
                </div>

                @if (_orphanOffers is not null)
                {
                    @if (_orphanOffers.Count == 0)
                    {
                        <div class="alert alert-success py-2">Nothing to end — every active offer still passes the listing options.</div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2">
                            <strong>@_orphanOffers.Count</strong> active offer(s) no longer pass the listing options.
                            Check the reason on each before ending — this takes them off sale.
                        </div>
                        <div class="table-responsive mb-3" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr><th>Offer</th><th>EAN</th><th>Reason</th><th class="text-end">Id</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var offer in _orphanOffers)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(offer.Name) ? "—" : offer.Name)</td>
                                            <td><code>@offer.Ean</code></td>
                                            <td class="small text-muted">@offer.Reason</td>
                                            <td class="text-end">
                                                <a href="https://allegro.pl/oferta/@offer.Id" target="_blank">@offer.Id</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                <pre class="bg-dark text-light p-3 rounded mb-0" style="max-height: 240px; overflow-y: auto; font-size: 0.8rem; white-space: pre-wrap;">@(allegro.Logs.Count == 0 ? "No publish activity yet." : string.Join("\n", allegro.Logs))</pre>
            </div>
        </div>
    </div>
</div>


@code{
    private ParseResponse _lastParsing = new ParseResponse();
    private ListingOptions _listingOptions = new ListingOptions();
    
    private StartParserProcessOptions _consoleAdvancedOptions = new StartParserProcessOptions();
    private static StartParserProcessOptions _consoleBaseStartOptions = new StartParserProcessOptions();
    private static StartParserProcessOptions _consoleBrowserOnlyOptions = new StartParserProcessOptions() { ConfigureBrowser = true };
    
    private bool isStartedConsole => saveData.Value.StartedConsoleId != null;
    private bool _isLastParseSuccess => _lastParsing.CurrentIndexUrl == _lastParsing.AllUrls.Count - 1;
    private int _progressPercent => _lastParsing.AllUrls.Count == 0
        ? 0
        : (int)Math.Round((_lastParsing.CurrentIndexUrl + 1) * 100.0 / _lastParsing.AllUrls.Count);

    private static readonly ConcurrentQueue<string> _consoleLogs = new();
    private const int MaxLogLines = 300;
    private Timer? _logRefreshTimer;

    private AllegroPublishService.DeviceFlowInfo? _deviceInfo;

    private List<AllegroPublisher.OrphanOffer>? _orphanOffers;
    private bool _isScanning;
    private bool _isEndingOrphans;

    private List<BundlePlan.BundleChange>? _bundlePlan;
    private bool _isPlanningBundles;
    private bool _isConverting;
    private int _convertibleBundles => _bundlePlan?.Count(c => c.CanConvert) ?? 0;
    private int _blockedBundles => _bundlePlan?.Count(c => !c.CanConvert) ?? 0;

    private List<OfferCreator.Candidate>? _unlisted;
    private bool _isScanningUnlisted;

    private int _unlistedNew;
    private int _unlistedTotal;

    protected override void OnInitialized()
    {
        _logRefreshTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override void OnParametersSet()
    {
        _lastParsing = SaverExtensions.LastParse.Read();
        _listingOptions = SaverExtensions.ListingOptions.Read();
        RefreshUnlisted();
    }

    private void RefreshUnlisted()
    {
        var tracker = new UnlistedTracker();
        _unlistedNew = tracker.NewCount;
        _unlistedTotal = tracker.Count;
    }

    private void MarkImported()
    {
        try
        {
            new UnlistedTracker().MarkImported();
            RefreshUnlisted();
            toastService.ShowSuccess($"Counter cleared. {_unlistedTotal} product(s) still have no offer.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }

    public void Dispose()
    {
        _logRefreshTimer?.Dispose();
    }

    private void AddPriceTier()
    {
        var nextBound = _listingOptions.PriceMultipliers.Count == 0
            ? 10m
            : _listingOptions.PriceMultipliers.Max(t => t.MaxPrice) + 10m;
        _listingOptions.PriceMultipliers.Add(new PriceTier { MaxPrice = nextBound, Multiplier = 1m });
    }

    private void AddPackTier()
    {
        var nextBound = _listingOptions.PackDivisors.Count == 0
            ? 10
            : _listingOptions.PackDivisors.Max(t => t.MaxMinOrder) * 2;
        _listingOptions.PackDivisors.Add(new PackTier { MaxMinOrder = nextBound, Divisor = 1 });
    }

    private void AddBundlePriceTier()
    {
        var nextBound = _listingOptions.BundlePriceMultipliers.Count == 0
            ? 100m
            : _listingOptions.BundlePriceMultipliers.Max(t => t.MaxPrice) + 100m;
        _listingOptions.BundlePriceMultipliers.Add(new PriceTier { MaxPrice = nextBound, Multiplier = _listingOptions.BundleDefaultMultiplier });
    }

    private void SaveAllOptions()
    {
        try
        {
            saveData.Write();
            SaverExtensions.ListingOptions.Value = _listingOptions;
            SaverExtensions.ListingOptions.Write();
            allegro.SaveSettings();
            toastService.ShowSuccess("Options saved successfully!");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }

    private async Task ConnectAllegro()
    {
        try
        {
            _deviceInfo = await allegro.ConnectAsync();
            toastService.ShowInfo("Confirm the code on Allegro to finish connecting.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }

    private async Task RefreshTokenAllegro()
    {
        try
        {
            bool refreshed = await allegro.RefreshToken();
            if (refreshed == false) throw new Exception();
            toastService.ShowSuccess("Token is refreshed");
        }
        catch
        {
            toastService.ShowError("Can`t refresh allegro token");
        }
    }

    private async Task BuildBundlePlan()
    {
        _isPlanningBundles = true;
        try
        {
            _bundlePlan = await allegro.BuildBundlePlanAsync();
            toastService.ShowInfo($"{_convertibleBundles} offer(s) can be converted to packs.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isPlanningBundles = false;
        }
    }

    private async Task ConvertBundles()
    {
        if (_bundlePlan is null or { Count: 0 })
        {
            return;
        }

        _isConverting = true;
        try
        {
            var result = await allegro.ConvertBundlesAsync(_bundlePlan);
            toastService.ShowSuccess($"Converted {result.Converted}, skipped {result.Skipped}, failed {result.Failed}.");
            _bundlePlan = null; // force a rebuild so the table can't go stale
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isConverting = false;
        }
    }

    private async Task ScanUnlisted()
    {
        _isScanningUnlisted = true;
        try
        {
            _unlisted = await allegro.PlanNewOffersAsync();
            toastService.ShowInfo($"{_unlisted.Count(c => c.CanCreate)} product(s) could be listed.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isScanningUnlisted = false;
        }
    }

    private async Task ScanOrphanOffers()
    {
        _isScanning = true;
        try
        {
            _orphanOffers = await allegro.FindOrphanOffersAsync();
            toastService.ShowInfo($"Found {_orphanOffers.Count} unlisted offer(s).");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isScanning = false;
        }
    }

    private async Task EndOrphanOffers()
    {
        if (_orphanOffers is null or { Count: 0 })
        {
            return;
        }

        _isEndingOrphans = true;
        try
        {
            var ended = await allegro.EndOffersAsync(_orphanOffers.Select(o => o.Id));
            toastService.ShowSuccess($"Ended {ended} offer(s).");
            _orphanOffers = null; // force a rescan so the list can't go stale
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
        finally
        {
            _isEndingOrphans = false;
        }
    }

    private async Task PublishToAllegro()
    {
        try
        {
            var updated = await allegro.PublishAsync();
            toastService.ShowSuccess($"Published: {updated} offers updated.");
        }
        catch (Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }

    private void StartConsole(string pathDll,string args)
    {
        try
        {
            string workingDirectory = Path.GetDirectoryName(pathDll) ?? "";
            var process = new Process
            {
                StartInfo = new ProcessStartInfo()
                {
                    Arguments = $"\"{pathDll}\" {args}",
                    WorkingDirectory = workingDirectory,
                    FileName = "dotnet",
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true,
                },
                EnableRaisingEvents = true,
            };
            process.OutputDataReceived += (_, e) => AppendLog(e.Data);
            process.ErrorDataReceived += (_, e) => AppendLog(e.Data);
            process.Exited += (_, _) => AppendLog("[console process exited]");

            if (process.Start())
            {
                process.BeginOutputReadLine();
                process.BeginErrorReadLine();
                saveData.Value.StartedConsoleId = process.Id.ToString();
                saveData.Write();
            }
        }
        catch(Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }

    private static void AppendLog(string? line)
    {
        if (string.IsNullOrEmpty(line))
        {
            return;
        }
        _consoleLogs.Enqueue($"[{DateTime.Now:HH:mm:ss}] {line}");
        while (_consoleLogs.Count > MaxLogLines && _consoleLogs.TryDequeue(out _))
        {
        }
    }

    private void ClearLogs()
    {
        _consoleLogs.Clear();
    }

    private void StopConsole()
    {
        try
        {
            Process.Start("kill", saveData.Value.StartedConsoleId ?? "");
            saveData.Value.StartedConsoleId = null;
            saveData.Write();
        }
        catch(Exception e)
        {
            toastService.ShowError(e.Message);
        }
    }
    
    private class StartParserProcessOptions
    {
        public int StartIndex { get; set; } = 0;
        public bool ConfigureBrowser { get; set; } = false;
        public bool LoadLastSession { get; set; } = false;
        public bool IsVisible { get; set; } = true;
        public string TestUrl { get; set; } = "";
        
        public string Args => 
            (TestUrl.Trim().Length > 0 ? $"--test-url={TestUrl.Trim()} " : "") +
            (StartIndex > 0 ? $"--start-index={StartIndex} " : "") +
            (ConfigureBrowser ? "--configure-browser " : "") +
            (LoadLastSession ? "--load_last_session " : "") +
            (IsVisible ? "--visible " : "");
    }
}